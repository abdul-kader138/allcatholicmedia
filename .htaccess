RewriteEngine On

# Redirect trailing slashes when the target is not a real directory.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

# In a subfolder deployment such as /dev, REQUEST_URI includes the folder
# prefix, so checking %{REQUEST_URI} !^public can loop. Short-circuit any
# request that already targets the public directory, then forward everything
# else into public/.
RewriteRule ^public/ - [L]
RewriteRule ^(.*)$ public/$1 [L]
